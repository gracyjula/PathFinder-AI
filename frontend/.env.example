# NeuraLearn AI - Frontend Environment Variables
# ================================================
# Copy this file to .env.local for local dev, or set in Vercel dashboard for production.
# NEVER commit .env.local to git — it is in .gitignore.
#
# For Vercel deployment, set these in:
# Dashboard → your project → Settings → Environment Variables
# ================================================

# ── API URL ────────────────────────────────────────────────────────────────────
# LOCAL DEV: Leave empty — the Vite proxy (/api → localhost:8000) handles it.
# PRODUCTION: Set to your Render backend URL.
#   Example: VITE_API_URL=https://neuralearn-backend.onrender.com/api/v1
VITE_API_URL=
