# NeuraLearn AI - Backend Environment Variables
# ==============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to git — it is in .gitignore.
#
# For Render deployment, set these in the Render dashboard under:
# Dashboard → your service → Environment → Environment Variables
# ==============================================

# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME=NeuraLearn AI
APP_VERSION=1.0.0
DEBUG=false

# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS

# ── Database ───────────────────────────────────────────────────────────────────
# LOCAL DEV — use SQLite (no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./neuralearn.db
SYNC_DATABASE_URL=sqlite:///./neuralearn.db

# PRODUCTION (Render) — use PostgreSQL:
# Render auto-injects DATABASE_URL when you add a PostgreSQL add-on.
# The asyncpg URL format must start with postgresql+asyncpg://
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/neuralearn
# SYNC_DATABASE_URL=postgresql://user:password@host:5432/neuralearn

# ── Redis (optional — app works without it) ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AI Keys (add at least one for full AI features) ────────────────────────────
# Get a FREE Gemini key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ── ChromaDB (optional — only needed for vector search) ────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=neuralearn_resources

# ── JWT ────────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ───────────────────────────────────────────────────────────────────────
# Set to your Vercel production URL in production.
# Comma-separated list supported: https://app.vercel.app,https://custom-domain.com
FRONTEND_URL=http://localhost:5173

# ── File Upload ────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
